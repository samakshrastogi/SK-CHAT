# Upload security and quotas
UPLOAD_DAILY_QUOTA_MB=250
UPLOAD_DAILY_FILE_LIMIT=100
MALWARE_SCAN_REQUIRED=true
MALWARE_SCAN_URL=https://scanner.example.com/v1/scan
MALWARE_SCAN_TOKEN=replace-with-scanner-token
