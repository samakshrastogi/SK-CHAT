NODE_ENV=production
PORT=10000
MONGODB_URI=PASTE_CHAT_MONGODB_URI
MONGODB_DATABASE=sk_connect
FRONTEND_URL=https://connect.sk-hub.in
ALLOWED_ORIGINS=https://connect.sk-hub.in
BACKEND_URL=https://sk-chat-k2u8.onrender.com
SK_CENTRAL_SSO_SECRET=PASTE_SAME_VALUE_AS_SK_CENTRAL_SSO_TOKEN_SECRET
SK_CENTRAL_API_URL=https://www.sk-hub.in/api
JWT_ACCESS_SECRET=PASTE_RANDOM_SECRET
JWT_REFRESH_SECRET=PASTE_DIFFERENT_RANDOM_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
GEMINI_API_KEY=PASTE_SHARED_SK_CENTRAL_VALUE
GEMINI_MODEL=gemini-3.5-flash
RESEND_API_KEY=PASTE_SHARED_SK_CENTRAL_VALUE
MAIL_FROM=PASTE_SHARED_SK_CENTRAL_VALUE
CLOUDINARY_CLOUD_NAME=PASTE_CHAT_VALUE
CLOUDINARY_API_KEY=PASTE_CHAT_VALUE
CLOUDINARY_API_SECRET=PASTE_CHAT_VALUE
REDIS_URL=PASTE_CHAT_VALUE
REQUIRE_REDIS=true
REQUIRE_PERSISTENT_MEDIA=true

TURN_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=PASTE_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_TURN_TOKEN_ID=PASTE_CLOUDFLARE_TURN_TOKEN_ID
CLOUDFLARE_TURN_API_TOKEN=PASTE_CLOUDFLARE_TURN_API_TOKEN
TURN_CREDENTIAL_TTL_SECONDS=3600
REQUIRE_TURN=true

# Upload security and quotas
UPLOAD_DAILY_QUOTA_MB=250
UPLOAD_DAILY_FILE_LIMIT=100
MALWARE_SCAN_PROVIDER=cloudmersive
CLOUDMERSIVE_API_KEY=PASTE_CLOUDMERSIVE_API_KEY
MALWARE_SCAN_TIMEOUT_MS=30000
MALWARE_SCAN_REQUIRED=true
