RESEND_API_KEY=PASTE_SHARED_SK_CENTRAL_VALUE
MAIL_FROM=PASTE_SHARED_SK_CENTRAL_VALUE
CLOUDINARY_CLOUD_NAME=PASTE_CHAT_VALUE
CLOUDINARY_API_KEY=PASTE_CHAT_VALUE
CLOUDINARY_API_SECRET=PASTE_CHAT_VALUE
