ALLOWED_ORIGINS=https://connect.sk-hub.in
BACKEND_URL=https://sk-chat-k2u8.onrender.com
SK_CENTRAL_SSO_SECRET=PASTE_SAME_VALUE_AS_SK_CENTRAL_SSO_TOKEN_SECRET
