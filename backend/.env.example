PORT=5000
MONGODB_URI=mongodb://localhost:27017/connect
JWT_ACCESS_SECRET=your_jwt_access_secret_key_should_be_long_and_secure
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_should_be_long_and_secure
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Nodemailer configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@connect.chat

# Cloudinary configuration (optional, falls back to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini AI configuration (optional, falls back to mock responses)
GEMINI_API_KEY=

# App URLs
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
